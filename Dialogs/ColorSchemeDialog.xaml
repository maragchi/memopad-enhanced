<Window x:Class="Memopad.Dialogs.ColorSchemeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配色方案"
        Width="720" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!--
        16 种护眼配色（step3 FB-4）。一次同时更换背景色与文字色。
        每种配色用卡片展示，点击选择。下方预览用当前字体显示样例。
    -->
    <Window.Resources>
        <!-- パターンのカード。背景はパターンの背景色、文字はパターンの文字色。選択中は太い枠 -->
        <Style x:Key="CardStyle" TargetType="Button">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="84" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#80808080" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C0808080" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="浅色（亮色背景）" Padding="6">
            <UniformGrid x:Name="LightCards" Columns="4" HorizontalAlignment="Left" />
        </GroupBox>
        <GroupBox Grid.Row="1" Header="深色（暗色背景）" Padding="6" Margin="0,12,0,0">
            <UniformGrid x:Name="DarkCards" Columns="4" HorizontalAlignment="Left" />
        </GroupBox>

        <GroupBox Grid.Row="2" Header="预览" Margin="0,12,0,0" Padding="8">
            <Border x:Name="PreviewBorder" MinHeight="88" CornerRadius="4" BorderBrush="#80808080" BorderThickness="1" Padding="12,8">
                <DockPanel>
                    <TextBlock x:Name="PreviewName" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock x:Name="PreviewText" TextWrapping="Wrap"
                               Text="背景色与文字色可以一次更换。&#10;The quick brown fox jumps over the lazy dog. 0123456789" />
                </DockPanel>
            </Border>
        </GroupBox>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" Opacity="0.8" TextWrapping="Wrap" Text="按确定后背景色与文字色会一起更改。想单独更改时请使用「颜色更改...」。" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="确定" MinWidth="96" Padding="12,6" IsDefault="True" Click="Ok_Click" />
                <Button Content="取消" MinWidth="96" Padding="12,6" Margin="10,0,0,0" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
