<Window x:Class="Memopad.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 MemoPad"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="MemoPad" FontSize="24" FontWeight="Bold" />
        <TextBlock x:Name="VersionText" Margin="0,4,0,12" Opacity="0.8" />
        <TextBlock TextWrapping="Wrap" Text="保留 Windows 记事本的全部功能，并可以自由更换背景色、文字色与字体的文本编辑器。" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
            <Run Text="设置文件：" /><Run x:Name="SettingsPathText" />
        </TextBlock>
        <Button Content="OK" MinWidth="96" HorizontalAlignment="Right" Margin="0,20,0,0" IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>
