<Window x:Class="Memopad.Dialogs.SaveChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MemoPad"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <!-- 与记事本相同的「保存／不保存／取消」三选一（用 MessageBox 会变成「是／否」） -->
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,20" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Fluent 主题的 Button 不把字符串里的 "_" 当访问键，所以用 AccessText -->
            <Button x:Name="SaveButton" MinWidth="96" Margin="0,0,8,0" IsDefault="True" Click="SaveButton_Click">
                <AccessText Text="保存(_S)" />
            </Button>
            <Button x:Name="DontSaveButton" MinWidth="96" Margin="0,0,8,0" Click="DontSaveButton_Click">
                <AccessText Text="不保存(_N)" />
            </Button>
            <Button x:Name="CancelButton" Content="取消" MinWidth="96" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
